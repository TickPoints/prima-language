// `time` module signatures (spec §18.4 / appendix B.5).
// `@builtin` declarations are signature-only: each binds to the Rust-hosted implementation
// registered under `time::<name>` / `time::Duration::<name>` (spec §18.4). Times and durations
// are numbers (unix seconds; durations may be fractional).

@builtin
pub fn now() -> Integer;
@builtin
pub fn sleep(secs: F64);
@builtin
pub fn unix_timestamp(t: Number) -> Integer;
@builtin
pub fn format(t: Number, fmt: String) -> String;
@builtin
pub fn parse(s: String, fmt: String) -> Result<Number, String>;
@builtin
pub fn Duration::from_secs(n: Integer) -> Number;
@builtin
pub fn Duration::from_millis(n: Integer) -> Number;
