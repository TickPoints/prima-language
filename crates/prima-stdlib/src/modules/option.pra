//! The `Option` type and its method set (spec §16.3/§18.1).
//!
//! Method list and usage are maintained here; the `///` comments are the single source of truth
//! and feed `prima doc` and diagnostic notes (spec §4.1/§16.4). All methods are native (the
//! collapse family, spec §9.3): `unwrap`/`unwrap_or`/`expect` discard the error per spec §16.3.

/// An optional value: `Some(v)` or `None` (spec §4.4).
class Option {
    /// `true` when `self` carries a value.
    pub fn is_some(self) -> Bool @builtin,
    /// `true` when `self` is `None`.
    pub fn is_none(self) -> Bool @builtin,
    /// The inner value, panicking on `None`.
    pub fn unwrap(self) -> Value @builtin,
    /// The inner value, or `default` on `None`.
    pub fn unwrap_or(self, default: Value) -> Value @builtin,
    /// The inner value, panicking with `message` on `None`.
    pub fn expect(self, message: String) -> Value @builtin,
}
