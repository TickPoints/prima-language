// Broadcast (spec §11.4): pure functions apply elementwise over numeric arrays (enabled by default).
// Array + Array concatenates (v2.1, spec §11.3); Array + scalar stays elementwise.
let f(x) = x^2;
let v = [1, 2, 3];
println(f(v));
println(v + 10);
println([1, 2, 3] + [10, 20, 30]);
println([1, 2, 3]^2);
