// Collapse function family (spec §9.2, §9.3, §9.6): explicit numeric conversion via `to_f64` / `try_i32` + `unwrap_or` / `truncated_i32`.
let a = sqrt(2);
println(to_f64(a));
let c = try_i32(1e20);
println(c |> unwrap_or(0));
println(truncated_i32(7/2));

// Expected output:
// 1.4142135623730951
// 0
// 3
