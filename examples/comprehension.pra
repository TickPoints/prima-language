// Comprehensions (spec §11.7, v2.1): `[output for var in iterable if cond]` with nested `for`.
let squares = [x^2 for x in range(0, 10)];
println(squares);                 // → [0, 1, 4, 9, 16, 25, 36, 49, 64, 81]
let evens = [x for x in range(0, 10) if x % 2 == 0];
println(evens);                   // → [0, 2, 4, 6, 8]
let pairs = [(x, y) for x in range(0, 2) for y in range(0, 2)];
println(pairs);                   // → [(0, 0), (0, 1), (1, 0), (1, 1)]

// The outer bracket decides the result type: `[]` → Array, `{k: v}` → Dict, `{v}` → Set, `()` → Tuple.
let table = {x: x^2 for x in range(0, 5)};
println(table);                   // → {0: 0, 1: 1, 2: 4, 3: 9, 4: 16}
let odds = {x for x in range(0, 10) if x % 2 == 1};
println(odds);                    // → {1, 3, 5, 7, 9}
let gens = ((x, x + 1) for x in range(0, 3));
println(gens);                    // → ((0, 1), (1, 2), (2, 3))

// Iterables: Array, Dict (keys), Set, String (chars), Tuple.
let up = [c for c in "ab"];
println(up);                      // → ['a', 'b']
let keys = [k for k in { "x": 1, "y": 2 }];
println(keys);                    // → ["x", "y"]
println(len(squares));            // → 10
