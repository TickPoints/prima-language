// Error handling (spec §16.3): no try/catch — errors are values; `match`, `?`, and the unwrap family.
fn parse_and_double(s: String) -> Result<F64, Error> {
    let v = try_f64(s)?;
    return Ok(v * 2.0);
}

match parse_and_double("3.14") {
    Ok(x)  => println(f"parsed {x}"),
    Err(e) => println(f"failed: {e}")
}
println(parse_and_double("2.5").unwrap_or(0.0));
println(parse_and_double("6.0").unwrap());
println(parse_and_double("8.0").expect("parse failed"));

// Expected output:
// parsed 6.28
// 5
// 12
// 16
