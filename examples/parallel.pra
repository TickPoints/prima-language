// Parallel broadcast (spec §17.4, v2.1): `@parallel` MFn broadcast over large arrays is split across
// rayon threads (≥ 1024 elements); small arrays stay sequential. `range` builds the input array.
let f(x) @parallel = x^2 + 1;
let v = range(0, 2000);
let w = f(v);                     // parallel elementwise broadcast
println(w[0], w[1999]);           // → 1 3996002

let g(x) @parallel = x^2 + 1;
let u = range(0, 3000);
let r = g(u);
println(r[0], r[2999]);           // → 1 8994002
