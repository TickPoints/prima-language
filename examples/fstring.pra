// f-strings (spec §18.1, v2.2): `f"..."` interpolation replaces the removed `format` function.
let name = "Prima";
let a = 42;
let x = 1;
let y = 2;

// Expression interpolation — any expression goes inside `{}`.
println(f"a is {a}");                // → a is 42
println(f"{x} + {y} = {x + y}");     // → 1 + 2 = 3
println(f"hello {name}");            // → hello Prima
println(f"nested: {to_f64(a) / 2}"); // → nested: 21

// `{{` and `}}` escape literal braces.
println(f"{{literal braces}}");      // → {literal braces}
println(f"count = {{{a}}}");         // → count = {42}

// `:spec` refinements: float precision and width/alignment.
let pi_f = to_f64(pi);
println(f"pi = {pi_f:0.2}");         // → pi = 3.14
println(f"pi = {pi_f:.4}");          // → pi = 3.1416
println(f"|{a:>6}|");                // → |    42|
println(f"|{a:<6}|");                // → |42    |
println(f"|{a:^6}|");                // → |  42  |
println(f"|{a:06}|");                // → |000042|

// All printable values interpolate.
println(f"flags = {true}, nil = {nil}");      // → flags = true, nil = nil
println(f"arr = {[1, 2, 3]}");                // → arr = [1, 2, 3]
println(f"s = {sqrt(2)}");                    // → s = \sqrt{2}

// Single-quoted `'...'` and raw `r"..."` string literals (spec §3).
println('single quoted string');     // → single quoted string
println(r"raw \n stays literal");    // → raw \n stays literal
println(rf"raw {name}\n");           // → raw Prima\n

// Expected output (LaTeX `print_format`):
// a is 42
// 1 + 2 = 3
// hello Prima
// nested: 21
// {literal braces}
// count = {42}
// pi = 3.14
// pi = 3.1416
// |    42|
// |42    |
// |  42  |
// |000042|
// flags = true, nil = nil
// arr = [1, 2, 3]
// s = \sqrt{2}
// single quoted string
// raw \n stays literal
// raw Prima\n
