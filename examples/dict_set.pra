// Dict and Set (spec §11.6, v2.1): mutable mappings and deduplicated collections.
// Dict literal `{ key: value }`; empty `{}` is an empty Dict.
let d = { "a": 1, "b": 2 };
println(d["a"]);                  // → 1
println(d.get("x"));              // → None (safe access)
println("a" in d);                // → true (membership on keys)
println(d.len());                 // → 2
d["b"] = 20;                      // element assignment (insert/update)
println(d["b"]);
d.insert("c", 3);
println(d.keys());                // → ["a", "b", "c"] (canonical key order)
println(d.values());
println(d.items());               // → [("a", 1), ("b", 20), ("c", 3)]
let dd = d.update({ "x": 9 });    // merge: later wins
println(dd.len());                // → 4
let popped = d.remove("a");       // → Some(1)
println(popped);
d.clear();
println(d.len());                 // → 0

// Set literal `{ a, b }` deduplicates.
let s = {1, 2, 3, 2};             // → {1, 2, 3}
println(s.len());                 // → 3
s.add(4);
println(s.contains(1));           // → true
println(3 in s);                  // → true
s.discard(99);                    // silent if absent
s.remove(2);                      // → removed; absent would error R0013
println(s);

// Set algebra: `∪`/`∩`/`\` (or the union/intersection/difference methods).
let t = {3, 4, 5};
println(s ∪ t);                   // → {1, 3, 4, 5}
println(s ∩ t);                   // → {3}
println(s \ {3});                 // → {1, 4}
println(s.union(t).len());        // → 4

// Keys/elements must be immutable and hashable (Number/String/Char/Bool).
let m = { 1: "one", 2: "two" };
println(m[1]);
let flags = {true, false};
println(flags.len());             // → 2
