// Patterns and destructuring (spec §4.4): tuple/struct destructuring, `if let`/`while let`, and full `match` patterns.
let (a, b) = (1, 2);
print(a + b);

let v = [10, 20, 30];
if let Some(x) = v.get(0) {
    print(x);
} else {
    print("none");
}

let i = 0;
while let Some(x) = v.get(i) {
    print(x);
    i = i + 1;
}

fn classify(n: Integer) -> String {
    let r = match n {
        0 => "zero",
        1 | 2 => "small",
        3..=9 => "medium",
        m if m > 100 => "large",
        _ => "other"
    };
    return r;
}
print(classify(5));
print(classify(1));
print(classify(200));
print(classify(-4));

// Matching on `Result` (spec §16.3) and `Option`.
let res = match try_i32(7) {
    Ok(n) => n,
    Err(e) => -1
};
print(res);

let opt = match Some(42) {
    Some(x) => x,
    None => 0
};
print(opt);

// `?` propagates `Err`/`None` inside a `Result`-returning function (spec §16.3).
fn try_parse(s: String) -> Result<Integer, Error> {
    let v = try_i32(s)?;
    return Ok(v);
}
print(try_parse("9").unwrap());

// Struct pattern destructuring (spec §4.4).
class Point {
    x: Integer,
    y: Integer,
    pub fn new(x, y) -> Self { Point { x, y } }
}
let p = Point::new(3, 4);
let Point { x, y } = p;
print(x + y);

// Expected output:
// 3
// 10
// 10
// 20
// 30
// medium
// small
// large
// other
// 7
// 42
// 9
// 7
