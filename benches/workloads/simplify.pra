// Symbolic simplification workload (spec §8): build a mixed trig/polynomial expression and
// simplify it, checksumming the rendered LaTeX length so the kernel returns a scalar.
pub fn main(n: Integer) -> Integer {
    let mut acc = 0;
    let mut i = 0;
    while i < n {
        let e = tex"\sin(x)^2 + \cos(x)^2 + x^2 + 1";
        acc += to_string(simplify(e)).len();
        i += 1;
    }
    acc
}
