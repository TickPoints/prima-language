// Collection workload (spec §11.6): insert n integer keys, then look them all up and sum the values.
pub fn main(n: Integer) -> Integer {
    let mut d = {};
    let mut i = 0;
    while i < n {
        d[i] = i * i;
        i += 1;
    }
    let mut s = 0;
    let mut j = 0;
    while j < n {
        s += d[j];
        j += 1;
    }
    s
}
