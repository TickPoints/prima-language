// Collection workload (spec §11.3): build a deterministic integer array, sort it, and sum three
// fixed positions so the kernel returns a scalar.
pub fn main(n: Integer) -> Integer {
    let mut a = [];
    let mut i = 0;
    while i < n {
        a.push((i * 7919 + 13) % 10007);
        i += 1;
    }
    let s = sorted(a);
    s[0] + s[n / 2] + s[n - 1]
}
